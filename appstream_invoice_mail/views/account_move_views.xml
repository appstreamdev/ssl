<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_invoice_mail" model="ir.ui.view">
        <field name="name">account.move.form.invoice.mail.payment.mode</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                <field name="invoice_mail_payment_mode"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="is_sepa_dd_communication"
                       readonly="1"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>

</odoo>
