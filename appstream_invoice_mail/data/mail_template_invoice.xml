<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_invoice_payment_mode" model="mail.template">
            <field name="name">Rechnung: Versand (SEPA-Lastschrift / Überweisung)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Ihre Rechnung {{ object.name or '' }} von {{ object.company_id.name }}</field>
            <field name="email_from">{{ (object.invoice_user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="description">Rechnungsversand an Kunden. Der Zahlungsabsatz wechselt automatisch zwischen SEPA-Lastschrifteinzug und Überweisung.</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Guten Tag
        <t t-if="object.partner_id.parent_id">
            <t t-out="object.partner_id.name or ''">Max Mustermann</t> (<t t-out="object.partner_id.parent_id.name or ''">Musterfirma GmbH</t>),
        </t>
        <t t-else="">
            <t t-out="object.partner_id.name or ''">Max Mustermann</t>,
        </t>
        <br/>
        <br/>
        anbei erhalten Sie die Rechnung<t t-if="object.name"> <span style="font-weight: bold;" t-out="object.name or ''">RE/2026/00005</span></t>
        über <span style="font-weight: bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">1.234,00 €</span>.<br/>
        <t t-if="object.invoice_origin">Die Rechnung bezieht sich auf den Auftrag: <t t-out="object.invoice_origin or ''">VR250001</t><br/></t>
        <t t-if="object.ref">Projektnummer: <t t-out="object.ref or ''">KND-HSP-001</t><br/></t>
        <br/>
        <t t-if="object.payment_state in ('paid', 'in_payment')">
            Die Rechnung ist bereits ausgeglichen – Sie müssen nichts weiter veranlassen.<br/>
        </t>
        <t t-elif="object.is_sepa_dd_communication">
            Der Einzug wird in den nächsten Tagen per SEPA-Lastschrifteinzug stattfinden.<br/>
            <t t-if="object.sdd_mail_mandate_ref or object.sdd_mail_debtor_iban">
                <span style="color: #6b7280; font-size: 12px;">
                    <t t-if="object.sdd_mail_mandate_ref">Mandatsreferenz: <t t-out="object.sdd_mail_mandate_ref or ''">MANDATE-0001</t></t>
                    <t t-if="object.sdd_mail_creditor_id"> · Gläubiger-Identifikationsnummer: <t t-out="object.sdd_mail_creditor_id or ''">DE98ZZZ09999999999</t></t>
                    <t t-if="object.sdd_mail_debtor_iban"> · Belastetes Konto: <t t-out="object.sdd_mail_debtor_iban or ''">DE02120300000000202051</t></t>
                </span><br/>
            </t>
        </t>
        <t t-else="">
            Bitte überweisen Sie den Rechnungsbetrag<t t-if="object.invoice_date_due"> bis zum <span style="font-weight: bold;" t-out="format_date(object.invoice_date_due) or ''">31.08.2026</span></t> auf das folgende Konto:<br/>
            <t t-if="object.mail_bank_account_id">
                <span style="color: #6b7280; font-size: 12px;">
                    Kontoinhaber: <t t-out="object.mail_bank_account_id.acc_holder_name or object.company_id.name or ''">Musterfirma GmbH</t><br/>
                    IBAN: <t t-out="object.mail_bank_account_id.acc_number or ''">DE02120300000000202051</t><t t-if="object.mail_bank_account_id.bank_id.bic"> · BIC: <t t-out="object.mail_bank_account_id.bank_id.bic or ''">BYLADEM1001</t></t><br/>
                </span>
            </t>
            Verwendungszweck: <span style="font-weight: bold;" t-out="object.payment_reference or object.name or ''">RE/2026/00005</span><br/>
        </t>
        <br/>
        Für Fragen zur Rechnung stehe ich Ihnen gerne jederzeit per Mail oder telefonisch zur Verfügung: 0170/5250836 <br/>Bei technischen Fragen finden Sie hier Unterstützung: <a href="https://www.app-stream.eu/helpdesk/serviceteam-1/knowledgebase" class="btn btn-fill-secondary" style="color: #111827; border-color: #e7e9ed; text-decoration: none; border-radius: 4px; border-style: solid; padding: 5px 10px; margin: 0px; box-sizing: border-box; border-width: 0.555556px; transition: none; box-shadow: var(--btn-box-shadow); background-color: #e7e9ed; user-select: none; cursor: pointer; vertical-align: middle; text-align: center; line-height: 1.5; font-weight: 500; font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, 'Noto Sans', Arial, 'Odoo Unicode Support Noto', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'; display: inline-block;"><font style="border-radius:0px;border-style:none;padding:0px;margin:0px;box-sizing:border-box;border-left-color:#374151;border-bottom-color:#374151;border-right-color:#374151;border-top-color:#374151;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;color: #374151;">Hilfebereich</font></a><br/>&#160;<br/>
        <t t-if="not is_html_empty(object.invoice_user_id.signature)" data-o-mail-quote-container="1">
            <br/>
            <div data-o-mail-quote="1">--<br data-o-mail-quote="1"/><t t-out="object.invoice_user_id.signature or ''" data-o-mail-quote="1">Andreas Preißer</t></div>
        </t>
    </p>
</div>
            </field>
        </record>

    </data>
</odoo>
